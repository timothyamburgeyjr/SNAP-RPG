* text=auto
# Files that run inside the Linux container must keep LF line endings
*.php  text eol=lf
*.sh   text eol=lf
*.conf text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Byte-exact files: line-ending changes would break them (a PDF's offsets, an SVG's served bytes)
*.pdf binary
*.svg text eol=lf

# Big binaries go to Git LFS. Uncomment a line when the first such file arrives.
# *.psd  filter=lfs diff=lfs merge=lfs -text
# *.tif  filter=lfs diff=lfs merge=lfs -text
# *.tiff filter=lfs diff=lfs merge=lfs -text
