# Copy to wiki/.env and fill in. wiki/.env is gitignored.
# Only for running the wiki offline without the tunnel. Leave it commented out normally:
# the wiki forces HTTPS, so localhost logins only work with $wgForceHTTPS also turned off.
# MW_SERVER=http://localhost:8180
MW_DB_PASSWORD=
MW_DB_ROOT_PASSWORD=
MW_SECRET_KEY=
MW_UPGRADE_KEY=
# Only used once, by the installer; you can blank it afterwards.
MW_ADMIN_PASSWORD=
